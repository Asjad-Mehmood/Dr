# Postgres connection string (Neon, Supabase, Vercel Postgres, or local).
DATABASE_URL=postgres://user:password@host:5432/dbname
# Long random string used to sign admin logins. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Public address of the site, e.g. https://naimaasjad.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Optional: Vercel Blob token. When set, uploads are stored on Vercel Blob
# (required on Vercel, whose servers can't keep uploaded files).
BLOB_READ_WRITE_TOKEN=
